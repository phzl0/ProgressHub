# Backend e worker: preencher somente no provedor. Nunca commitar valores reais.
NODE_ENV=production
# Render Free: embedded. Compose de dois serviços: separate.
COMMUNITY_WORKER_MODE=separate
PORT=3001
CLIENT=https://SEU-SITE.vercel.app
GITHUB_CALLBACK_URL=https://SEU-SITE.vercel.app/api/community/auth/callback
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER/usersDB
MONGODB_DB=usersDB
SESSION_SECRET=GERAR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
GITHUB_TOKEN_KEY=GERAR_64_CARACTERES_HEXADECIMAIS
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
COMMUNITY_ADMIN_GITHUB_IDS=
# Número real de proxies até a API: verificar no provedor antes de liberar acesso.
TRUST_PROXY=1
